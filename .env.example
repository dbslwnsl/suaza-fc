# ============================================================
# SUAZA FC 환경 변수 템플릿 — 실제 값은 절대 커밋하지 말 것!
#
# 새 PC 세팅 (권장 — Vercel에서 실제 값 내려받기):
#   1. npm i -g vercel && vercel login
#   2. vercel link            (이 저장소를 Vercel 프로젝트에 연결)
#   3. vercel env pull .env.local
#   4. 아래 NEXT_PUBLIC_DEV_TOOLS=1 은 로컬 개발시에만 .env.local 에 직접 추가
#
# 수동 세팅: 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
#   값 위치 — Supabase 대시보드 > Project Settings > API
# ============================================================

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role — RLS 우회 관리자 키. 서버 전용, 브라우저 노출 금지!
SUPABASE_SERVICE_ROLE_KEY=

# 웹 푸시 (VAPID). 생성: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 개발 도구 (직책 전환기 + 알림 발송 차단) — 로컬에서만 1. Vercel/프로덕션 금지!
NEXT_PUBLIC_DEV_TOOLS=1
